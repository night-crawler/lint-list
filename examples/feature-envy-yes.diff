+import { HotTracesView } from "@/features/hot-traces/views/hot-traces-view";
+import { useTimeRange } from "@/hooks/use-timerange";
+import { createFileRoute, getRouteApi } from "@tanstack/react-router";
+
+const rootRouteApi = getRouteApi("__root__");
+
+export const Route = createFileRoute(
+  "/_authenticated/project/$projectId/_layout/internal/hot-traces"
+)({
+  staticData: { command: null },
+  component: HotTraces,
+  beforeLoad: () => ({
+    facetsEnabled: true,
+    pageTitle: "Hot Traces (Internal)"
+  })
+});
+
+function HotTraces() {
+  const { projectId } = Route.useParams();
+  const { query } = Route.useSearch();
+  const { bootstrapInfo } = rootRouteApi.useRouteContext();
+  const { start_ts, end_ts } = useTimeRange();
+
+  return (
+    <HotTracesView
+      projectId={projectId}
+      startTs={start_ts}
+      endTs={end_ts}
+      query={query ?? undefined}
+      filterFacets={bootstrapInfo.cel}
+    />
+  );
+}
