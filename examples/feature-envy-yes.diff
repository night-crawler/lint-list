@@ -0,0 +1,204 @@
+import { PageHeader } from "@/components/page-header";
+import { HotTraceCard } from "@/features/hot-traces/components/hot-trace-card";
+import {
+  type CelSupport,
+  type EventKind,
+  TableSortDirection
+} from "@/generated/ts-client";
+import { useGetHotTraces } from "@/queries/hot-traces";
+import {
+  Card,
+  EmptyState,
+  PaginationControls,
+  BaseSelect,
+  Spinner,
+  Text
+} from "@repo/component-library";
+import * as React from "react";
+
+interface HotTracesViewProps {
+  projectId: string;
+  startTs: number;
+  endTs: number;
+  query?: string;
+  filterFacets: CelSupport;
+}
+
+const DEFAULT_PAGE_SIZE = 20;
+const PAGE_SIZE_OPTIONS = [10, 20, 50, 100];
+
+const EVENT_KIND_OPTIONS: { value: EventKind; label: string }[] = [
+  { value: "on_cpu", label: "On-CPU" },
+  { value: "off_cpu", label: "Off-CPU" },
+  { value: "alloc", label: "Allocations" },
+  { value: "cuda", label: "CUDA" },
+  { value: "pc_sample", label: "PC Sample" }
+];
+
+export function HotTracesView({
+  projectId,
+  startTs,
+  endTs,
+  query,
+  filterFacets
+}: HotTracesViewProps) {
+  const [pageSize, setPageSize] = React.useState(DEFAULT_PAGE_SIZE);
+  const [sortDirection, setSortDirection] = React.useState<TableSortDirection>(
+    TableSortDirection.Desc
+  );
+  const [eventKind, setEventKind] = React.useState<EventKind>("on_cpu");
+  const sortMetric =
+    eventKind === "alloc"
+      ? "Allocated Bytes"
+      : eventKind === "pc_sample"
+        ? "total_secs"
+        : "Total Time";
+  const sortOptions = [
+    { value: TableSortDirection.Desc, label: `${sortMetric} (High to Low)` },
+    { value: TableSortDirection.Asc, label: `${sortMetric} (Low to High)` }
+  ];
+  const scopeKey = JSON.stringify([
+    projectId,
+    startTs,
+    endTs,
+    query,
+    eventKind,
+    sortDirection,
+    pageSize
+  ]);
+  const [pageState, setPageState] = React.useState({
+    scopeKey,
+    page: 1
+  });
+  const currentPage = pageState.scopeKey === scopeKey ? pageState.page : 1;
+
+  if (pageState.scopeKey !== scopeKey) {
+    setPageState({ scopeKey, page: 1 });
+  }
+
+  const { data, isLoading, isError, error } = useGetHotTraces(
+    projectId,
+    {
+      filter: {
+        start_ts: startTs,
+        end_ts: endTs,
+        query,
+        event_kind: eventKind
+      },
+      pagination: {
+        sort: [{ field: "total_secs", direction: sortDirection }],
+        page: { page: currentPage, page_size: pageSize },
+        filter_text: null
+      }
+    },
+    { enabled: Boolean(projectId) }
+  );
+
+  const traces = data?.traces ?? [];
+  const itemCount = data?.pagination.item_count ?? undefined;
+  const nextPage = data?.pagination.next_page;
+  const hasNextPage =
+    !isError &&
+    traces.length > 0 &&
+    (itemCount !== undefined
+      ? currentPage * pageSize < itemCount
+      : nextPage !== undefined
+        ? nextPage !== null && nextPage > currentPage
+        : traces.length === pageSize);
+  const totalPages = hasNextPage
+    ? itemCount !== undefined
+      ? Math.ceil(itemCount / pageSize)
+      : currentPage + 1
+    : currentPage;
+
+  return (
+    <div className="gap-2xl px-4xl py-2xl flex h-full min-h-0 w-full flex-col">
+      <PageHeader
+        title="Hot Traces"
+        adornmentStart={
+          itemCount !== undefined ? (
+            <Text type="sm" state="tertiary">
+              {itemCount.toLocaleString()} trace{itemCount !== 1 ? "s" : ""}
+            </Text>
+          ) : undefined
+        }
+        adornment={
+          <div className="gap-md flex flex-wrap items-center">
+            <label htmlFor="hot-traces-event-kind" className="sr-only">
+              Event kind
+            </label>
+            <BaseSelect
+              id="hot-traces-event-kind"
+              size="sm"
+              value={eventKind}
+              options={EVENT_KIND_OPTIONS}
+              onChange={setEventKind}
+              className="w-36"
+            />
+            <label htmlFor="hot-traces-sort">
+              <Text type="sm" state="secondary">
+                Sort by:
+              </Text>
+            </label>
+            <BaseSelect
+              id="hot-traces-sort"
+              size="sm"
+              value={sortDirection}
+              options={sortOptions}
+              onChange={value => setSortDirection(value as TableSortDirection)}
+              className="w-56"
+            />
+          </div>
+        }
+      />
+
+      <div className="flex min-h-0 flex-1 flex-col overflow-auto">
+        {isLoading ? (
+          <div className="gap-md flex h-64 items-center justify-center">
+            <Spinner size="lg" />
+            <Text type="md" state="secondary">
+              Loading hot traces...
+            </Text>
+          </div>
+        ) : isError ? (
+          <EmptyState
+            title="Failed to load hot traces"
+            description={
+              error instanceof Error ? error.message : "An error occurred"
+            }
+          />
+        ) : traces.length === 0 ? (
+          <EmptyState
+            title="No hot traces found"
+            description="Try adjusting your filters or time range."
+          />
+        ) : (
+          <div className="gap-md flex flex-col">
+            {traces.map((trace, index) => (
+              <HotTraceCard
+                key={`${trace.event_kind}:${trace.prefix_hash}`}
+                trace={trace}
+                rank={(currentPage - 1) * pageSize + index + 1}
+                projectId={projectId}
+                filterFacets={filterFacets}
+                timeRange={{ start_ts: startTs, end_ts: endTs }}
+              />
+            ))}
+          </div>
+        )}
+      </div>
+
+      <Card className="p-lg shrink-0">
+        <PaginationControls
+          currentPage={currentPage}
+          totalPages={totalPages}
+          onPageChange={page => setPageState({ scopeKey, page })}
+          pageSize={pageSize}
+          pageSizeOptions={PAGE_SIZE_OPTIONS}
+          onPageSizeChange={setPageSize}
+          unknownPageCount={itemCount === undefined}
+        />
+      </Card>
+    </div>
+  );
+}
