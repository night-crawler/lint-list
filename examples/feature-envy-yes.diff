+import {
+  StackTraceFrameList,
+  symbolizedFrameToStackTraceFrame
+} from "@/components/flamegraph/stack-trace";
+import { WasmFlamegraph } from "@/components/flamegraph/wasm-flamegraph";
+import { formatCores } from "@/components/millicores-cell";
+import {
+  ENTITY_FIELDS,
+  getDisplayValue,
+  getFieldItems,
+  getFieldTotalCount
+} from "@/features/recommendations/entity-fields";
+import { formatTraceDuration } from "@/features/recommendations/utils/get-recommendation-trace-metric";
+import type {
+  CelSupport,
+  HotTrace,
+  SymbolizedFrame
+} from "@/generated/ts-client";
+import {
+  PROFILE_TYPES,
+  profileTypeEventKind,
+  profileTypeInfo,
+  type ProfileType
+} from "@/utils/profile-type-resolution";
+import { formatBytes } from "@/utils/unit";
+import {
+  Badge,
+  Card,
+  cn,
+  CopyButton,
+  Text,
+  Tooltip,
+  TooltipContent,
+  TooltipTrigger
+} from "@repo/component-library";
+import * as React from "react";
+
+interface HotTraceCardProps {
+  trace: HotTrace;
+  rank: number;
+  projectId: string;
+  filterFacets: CelSupport;
+  timeRange: { start_ts: number; end_ts: number };
+  suffixColumnLimit?: number;
+}
+
+function formatTraceCost(value: number, profileType: ProfileType | undefined) {
+  if (profileType === "alloc") {
+    return formatBytes(value);
+  }
+  return profileType ? formatTraceDuration(value) : value.toLocaleString();
+}
+
+function TraceFrames({ frames }: { frames: SymbolizedFrame[] }) {
+  const stackFrames = React.useMemo(
+    () =>
+      frames.map((frame, index) => {
+        const stackFrame = symbolizedFrameToStackTraceFrame(frame, index);
+        if (frame.file_name) {
+          stackFrame.name += ` (${frame.file_name}${frame.line ? `:${frame.line}` : ""})`;
+        }
+        return stackFrame;
+      }),
+    [frames]
+  );
+
+  return (
+    <StackTraceFrameList frames={stackFrames} className="max-h-64 min-w-0" />
+  );
+}
+
+function MetadataBadges({ trace }: { trace: HotTrace }) {
+  return (
+    <div className="gap-sm flex min-w-0 flex-wrap">
+      {ENTITY_FIELDS.map(({ key, label }) => {
+        const items = getFieldItems(trace, key);
+        if (items.length === 0) {
+          return null;
+        }
+        const totalCount = Math.max(
+          getFieldTotalCount(trace, key),
+          items.length
+        );
+
+        return (
+          <Tooltip key={key}>
+            <TooltipTrigger asChild>
+              <div className="min-w-0 max-w-full">
+                <Badge size="sm" type="neutral" className="max-w-full">
+                  <span className="truncate leading-normal">
+                    {label}: {getDisplayValue(items[0])}
+                  </span>
+                  {totalCount > 1 && (
+                    <span className="shrink-0">+{totalCount - 1}</span>
+                  )}
+                </Badge>
+              </div>
+            </TooltipTrigger>
+            <TooltipContent className="max-h-64 max-w-xs overflow-y-auto break-all">
+              <div className="space-y-1">
+                {items.map((item, index) => (
+                  <div key={index}>{getDisplayValue(item)}</div>
+                ))}
+                {totalCount > items.length && (
+                  <div>{totalCount - items.length} more not included</div>
+                )}
+              </div>
+            </TooltipContent>
+          </Tooltip>
+        );
+      })}
+      <Badge size="sm" type="neutral" className="max-w-full">
+        <span className="truncate leading-normal">
+          Event: {trace.event_kind}
+        </span>
+      </Badge>
+    </div>
+  );
+}
+
+export function HotTraceCard({
+  trace,
+  rank,
+  projectId,
+  filterFacets,
+  timeRange,
+  suffixColumnLimit = 3
+}: HotTraceCardProps) {
+  const prefixCount = trace.prefix?.length ?? 0;
+  const suffixCount = trace.suffixes?.length ?? 0;
+  const flamegraphContainerRef = React.useRef<HTMLDivElement>(null);
+  const [isVisible, setIsVisible] = React.useState(false);
+  const profileType = PROFILE_TYPES.find(
+    type => profileTypeEventKind(type) === trace.event_kind
+  );
+  const showFlamegraph =
+    suffixCount >= suffixColumnLimit &&
+    profileType !== undefined &&
+    (trace.wire?.length ?? 0) > 0;
+  const profileData = React.useMemo(
+    () =>
+      showFlamegraph && isVisible && trace.wire
+        ? new Uint8Array(trace.wire)
+        : undefined,
+    [showFlamegraph, isVisible, trace.wire]
+  );
+  const costLabel = profileType
+    ? profileTypeInfo(profileType).metricLabel
+    : "Cost";
+
+  React.useEffect(() => {
+    const container = flamegraphContainerRef.current;
+    if (!showFlamegraph || !container) {
+      return;
+    }
+
+    // Browsers limit active WebGL contexts; unmount offscreen flamegraphs so visible ones keep rendering.
+    const observer = new IntersectionObserver(
+      ([entry]) => setIsVisible(entry.isIntersecting),
+      { rootMargin: "256px" }
+    );
+    observer.observe(container);
+    return () => observer.disconnect();
+  }, [showFlamegraph]);
+
+  return (
+    <Card className="min-w-0 max-w-full">
+      <div className="gap-md border-border-secondary flex min-w-0 flex-wrap items-start justify-between border-b px-4 py-3">
+        <div className="gap-md flex min-w-0 flex-wrap items-center">
+          <div className="bg-bg-tertiary flex h-8 w-8 shrink-0 items-center justify-center rounded-full">
+            <Text type="sm" semibold state="secondary">
+              #{rank}
+            </Text>
+          </div>
+          <div className="min-w-0">
+            <Text type="md" semibold state="primary" className="break-all">
+              {formatTraceCost(trace.total_secs, profileType)}
+            </Text>
+            <Text type="xs" state="tertiary">
+              {costLabel}
+            </Text>
+          </div>
+          <div className="min-w-0">
+            <Text type="md" semibold state="primary">
+              {formatCores(trace.cores)}
+            </Text>
+            <Text type="xs" state="tertiary">
+              Cores (selected period)
+            </Text>
+          </div>
+        </div>
+        <div className="gap-md flex min-w-0 basis-full items-start sm:flex-1 sm:basis-auto sm:justify-end">
+          <MetadataBadges trace={trace} />
+          <CopyButton
+            getTextToCopy={() => JSON.stringify(trace, null, 2)}
+            tooltipText="Copy hot trace JSON to clipboard"
+            successMessage="Hot trace copied to clipboard"
+            buttonStyle="button"
+            className="shrink-0"
+          />
+        </div>
+      </div>
+      <div
+        className={cn(
+          "grid max-h-[48rem] min-w-0 overflow-y-auto",
+          showFlamegraph
+            ? "grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,7fr)]"
+            : "grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))]"
+        )}
+      >
+        <div className="border-border-secondary min-w-0 border-b lg:border-r">
+          <div className="border-border-secondary border-b px-4 py-2">
+            <div className="gap-sm flex flex-wrap items-center">
+              <Text type="sm" semibold state="primary">
+                Common Prefix
+              </Text>
+              <Badge size="sm" type="highlight">
+                {prefixCount} frame{prefixCount !== 1 ? "s" : ""}
+              </Badge>
+              <Badge size="sm" type="neutral">
+                {suffixCount} suffix{suffixCount !== 1 ? "es" : ""}
+              </Badge>
+            </div>
+          </div>
+          <div className="min-w-0 p-4">
+            {trace.prefix && prefixCount > 0 ? (
+              <TraceFrames frames={trace.prefix} />
+            ) : (
+              <Text type="sm" state="tertiary" className="italic">
+                No common prefix frames
+              </Text>
+            )}
+          </div>
+        </div>
+        {showFlamegraph ? (
+          <div
+            ref={flamegraphContainerRef}
+            className="h-80 min-w-0 overflow-hidden"
+          >
+            {isVisible && (
+              <WasmFlamegraph
+                name={`hot-trace-${trace.event_kind}-${trace.prefix_hash}`}
+                profileData={profileData}
+                type={profileType}
+                groupBy={[]}
+                projectId={projectId}
+                filterFacets={filterFacets}
+                timeRange={timeRange}
+                hideLegend
+              />
+            )}
+          </div>
+        ) : (
+          trace.suffixes?.map((suffix, index) => (
+            <div
+              key={index}
+              className="border-border-secondary min-w-0 border-b lg:border-r"
+            >
+              <div className="border-border-secondary border-b px-4 py-2">
+                <Text type="sm" semibold state="primary">
+                  {formatTraceCost(suffix.count, profileType)}
+                </Text>
+                <Text type="xs" state="tertiary">
+                  Suffix {index + 1} · {costLabel}
+                </Text>
+              </div>
+              <div className="min-w-0 p-4">
+                {suffix.frames.length > 0 ? (
+                  <TraceFrames frames={suffix.frames} />
+                ) : (
+                  <Text type="sm" state="tertiary" className="italic">
+                    No frames
+                  </Text>
+                )}
+              </div>
+            </div>
+          ))
+        )}
+      </div>
+    </Card>
+  );
+}
